# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# The base URL guests reach (used to build the QR code).
# On a phone this must be reachable from the guest's device — use your LAN IP
# (e.g. http://192.168.1.20:8888) when hosting a real party, not localhost.
PUBLIC_BASE_URL=http://127.0.0.1:8888

# Port the server listens on.
PORT=8888

# Session secret for signing the host cookie.
SESSION_SECRET=change_this_to_a_long_random_string
